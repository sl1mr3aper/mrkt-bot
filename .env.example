# ─── Telegram bot ───────────────────────────────────────────
BOT_TOKEN=123456:replace_with_token_from_botfather
ADMIN_ID=123456789

# ─── MRKT auth (https://my.telegram.org/auth) ───────────────
MRKT_API_ID=12345678
MRKT_API_HASH=0123456789abcdef0123456789abcdef
SESSION_NAME=mrkt_session

# ─── Proxy (optional, recommended for RU) ───────────────────
# PROXY_URL=socks5://user:pass@host:1080
PROXY_API_ONLY=true
TLS_IMPERSONATE=chrome124

# ─── Trading defaults ───────────────────────────────────────
DRY_RUN=true
STOP_LOSS_PCT=15.0
MAX_BUY_TON=10.0
MIN_PROFIT_TON=0.05
MARKET_COMMISSION_PCT=5.0
LARGE_DEAL_TON=5.0
MAX_DAILY_LOSS_TON=20.0
MAX_DAILY_TRADES=50

# ─── Timings ────────────────────────────────────────────────
COOLDOWN_SECONDS=60
ORDER_TIMEOUT_MINUTES=5
MONITOR_INTERVAL_MIN=20
MONITOR_INTERVAL_MAX=60
TOKEN_REFRESH_HOURS=20
PRICE_PARSE_MINUTES=30

# ─── Database ───────────────────────────────────────────────
DATABASE_PATH=data/mrkt_bot.db

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
LOG_ROTATION=1 day
LOG_RETENTION=30 days
